rules_version = '2';

// Reglas de Storage. La app ya no sube archivos: los certificados PDF se generan en el navegador
// y el QR abre la vista pública del lote. Se permite leer lo que ya exista y nadie puede subir,
// reemplazar ni borrar archivos (antes cualquier cuenta con sesión podía reemplazar un certificado).
service firebase.storage {
  match /b/{bucket}/o {
    match /lotes/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
