rules_version = '2';

// Reglas de seguridad para Cultivos Loré - Trazabilidad Tilapia Pro
// Base de datos: "ai-studio-33039dd2-b725-497c-80b6-eb6761337ba9"
service cloud.firestore {
  match /databases/{database}/documents {

    // Todo lo que no se permite explícitamente queda denegado
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function correoSesion() {
      return request.auth.token.get('email', '').lower();
    }

    // Administrador Maestro: Carlos (carlosbs1579@gmail.com), solo con el correo verificado por el
    // proveedor (Google lo verifica). Evita que una cuenta de correo y contraseña sin verificar
    // con ese mismo correo obtenga control total.
    function isMasterAdmin() {
      return isSignedIn()
        && correoSesion() == 'carlosbs1579@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }

    function perfilPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function tienePerfil() {
      return isSignedIn() && exists(perfilPath());
    }

    function perfil() {
      return get(perfilPath()).data;
    }

    function esActivo() {
      return isMasterAdmin() || (tienePerfil() && perfil().get('estado', '') == 'activo');
    }

    function esAdminGranja() {
      return isMasterAdmin() || (esActivo() && perfil().get('rol', '') == 'admin');
    }

    // Roles funcionales: admin, operator (producción) y courier (reparto); una cuenta puede tener
    // varios. Los perfiles anteriores a la lista de roles se interpretan desde su campo rol.
    // Los nombres visibles de cada función (cargos) nunca se usan para autorizar.
    function rolesDe(datos) {
      return datos.get('roles', datos.get('rol', 'operario') == 'admin' ? ['admin'] : ['operator']);
    }

    function tieneRol(rol) {
      return isMasterAdmin() || (esActivo() && rolesDe(perfil()).hasAny([rol]));
    }

    // Los permisos de producción solo aplican a administradores y a quienes tienen el rol de operador
    function tienePermiso(permiso) {
      return isMasterAdmin()
        || esAdminGranja()
        || (esActivo()
            && rolesDe(perfil()).hasAny(['operator'])
            && perfil().get('rol', '') != 'consulta'
            && perfil().get('permisos', {}).get(permiso, false) == true);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ---------- Lotes ----------
    // Campos que identifican al lote y su origen: ninguna actualización puede cambiarlos.
    // Así, escribir un lote nuevo sobre el código de uno existente queda rechazado.
    function camposFijosDelLoteIntactos() {
      return request.resource.data.get('codigo', null) == resource.data.get('codigo', null)
        && request.resource.data.get('consecutivo', null) == resource.data.get('consecutivo', null)
        && request.resource.data.get('granjaId', null) == resource.data.get('granjaId', null)
        && request.resource.data.get('fechaSiembra', null) == resource.data.get('fechaSiembra', null)
        && request.resource.data.get('creadoPor', null) == resource.data.get('creadoPor', null)
        && request.resource.data.get('creadoPorUid', null) == resource.data.get('creadoPorUid', null)
        && request.resource.data.get('creadoEn', null) == resource.data.get('creadoEn', null);
    }

    // Lectura pública de UN lote por su código para la trazabilidad oficial (QR). Listar los lotes
    // de la granja, con toda su información productiva, queda para administradores y operadores.
    match /lotes/{codigo} {
      allow get: if true;
      allow list: if esAdminGranja() || tieneRol('operator');

      // Creación: Solo lotes activos nuevos con los permisos correspondientes
      allow create: if (isMasterAdmin() || (isSignedIn() && tienePermiso('crearLotes')))
                    && request.resource.data.estado == 'activo';

      // Modificación o cierre: Solo permitido si el lote actualmente está ACTIVO (no sellado)
      // Una vez cerrado/sellado (resource.data.estado == 'cerrado'), queda estrictamente bloqueado.
      allow update: if (!('estado' in resource.data) || resource.data.estado == 'activo')
                    && camposFijosDelLoteIntactos()
                    && (
                      // Caso A: Incorporar eventos o modificar alevinos/piscina mientras el lote está activo
                      (request.resource.data.estado == 'activo'
                        && (isMasterAdmin() || (isSignedIn() && (tienePermiso('registrarEventos') || tienePermiso('crearLotes')))))
                      // Caso B: Cerrar o sellar el lote activo
                      || (request.resource.data.estado == 'cerrado'
                        && (isMasterAdmin() || (isSignedIn() && tienePermiso('cerrarLotes'))))
                    );

      // Eliminación: Reservada únicamente para el Administrador Maestro
      allow delete: if isMasterAdmin();
    }

    // ---------- Entregas a clientes (sistema anterior, solo historial) ----------
    // Cadena por lote en entregas/{codigo}, anclada al hash de cierre del lote. Desde la fase de
    // pedidos queda como historial de solo lectura: las reservas y entregas nuevas pasan por las
    // órdenes de entrega, para no comprometer dos veces el mismo lote.
    match /entregas/{codigo} {
      // Lectura pública de las entregas de UN lote (vista del QR); listar, solo administradores
      allow get: if true;
      allow list: if esAdminGranja();
      allow create, update, delete: if false;
    }

    // ---------- Pedidos: órdenes de entrega, clientes e inventario de lotes ----------
    // Las órdenes nunca escriben en los lotes: solo leen su cosecha registrada. Lo reservado de cada
    // lote se acumula en inventarioLotes/{codigo}, y cada movimiento del inventario debe coincidir
    // exactamente con la orden que se escribe en la misma operación. Así el servidor impide reservar
    // más de lo cosechado o reservar dos veces lo mismo, aunque dos personas lo intenten a la vez.
    // Las reglas de Firestore evalúan como máximo 1000 expresiones por operación (sumando todos los
    // documentos escritos). Por eso cada regla de esta sección delega en una función que lee los datos
    // una sola vez y, según el tipo de evento o de movimiento, valida a fondo solo ese caso.

    // Perfil de quien hace la solicitud: gestiona pedidos si es administrador, o si es operador
    // activo con el permiso "Gestionar pedidos"
    function gestionaPedidos(p) {
      return isMasterAdmin()
        || (p.get('estado', '') == 'activo'
            && (p.get('rol', '') == 'admin'
                || (p.get('rol', '') != 'consulta'
                    && rolesDe(p).hasAny(['operator'])
                    && p.get('permisos', {}).get('gestionarPedidos', false) == true)));
    }

    function puedeGestionarPedidos() {
      return gestionaPedidos(get(perfilPath()).data);
    }

    function granjaPermitida(granja) {
      return isMasterAdmin() || granja == granjaUsuario();
    }

    // Gestiona pedidos de esa granja (una sola lectura del perfil)
    function gestionaPedidosEn(granja) {
      let p = get(perfilPath()).data;
      return gestionaPedidos(p) && (isMasterAdmin() || p.get('granjaId', 'cultivos-lore') == granja);
    }

    function rutaOrden(id) {
      return /databases/$(database)/documents/ordenes/$(id);
    }

    function rutaInventario(codigo) {
      return /databases/$(database)/documents/inventarioLotes/$(codigo);
    }

    function rutaLote(codigo) {
      return /databases/$(database)/documents/lotes/$(codigo);
    }

    // Margen para las sumas de kg con decimales
    function igualCantidad(a, b) {
      return math.abs(a - b) < 0.000001;
    }

    // Producción verificable del lote: lo registrado en sus eventos de Cosecha, en la unidad pedida
    function cosechado(lote, unidad) {
      return unidad == 'peces'
        ? lote.get('resumen', {}).get('pecesCosechados', 0)
        : lote.get('resumen', {}).get('biomasaCosechadaKg', 0);
    }

    // Estados en los que la orden tiene cantidades reservadas
    function estadosConReserva() {
      return ['asignado', 'en_preparacion', 'en_ruta', 'requiere_revision'];
    }

    // Lo que falta por entregar de un lote de la orden (lo reservado que sigue a su nombre)
    function saldoLote(orden, codigo) {
      return orden.procedencias[codigo].cantidad - orden.get('entregadoPorLote', {}).get(codigo, 0);
    }

    // ===== inventarioLotes: aquí se validan las cantidades =====
    // Reserva: la orden pasa (en esta misma operación) de inexistente o borrador a asignada, incluye
    // este lote con su piscina, y el inventario sube exactamente su cantidad sin superar lo cosechado
    function reservaValida(codigo, reservadoAntes, nuevo) {
      let id = nuevo.ultimaOrden;
      let orden = getAfter(rutaOrden(id)).data;
      let procedencia = orden.procedencias[codigo];
      let lote = get(rutaLote(codigo)).data;
      return orden.estado == 'asignado'
        && (!exists(rutaOrden(id)) || get(rutaOrden(id)).data.estado == 'borrador')
        && orden.granjaId == nuevo.granjaId
        && procedencia.unidad == nuevo.unidad
        && procedencia.estanque == lote.estanque
        && procedencia.cantidad > 0
        && igualCantidad(nuevo.reservado - reservadoAntes, procedencia.cantidad)
        && nuevo.reservado + nuevo.entregado <= cosechado(lote, nuevo.unidad) + 0.000001;
    }

    // Liberación del saldo: la orden se cancela (desde un estado con reserva) o el operador cierra
    // una entrega parcial liberando lo que faltaba; el inventario baja exactamente ese saldo
    function liberacionValida(codigo, antes, nuevo) {
      let ordenAntes = get(rutaOrden(nuevo.ultimaOrden)).data;
      let estadoDespues = getAfter(rutaOrden(nuevo.ultimaOrden)).data.estado;
      return ((ordenAntes.estado in estadosConReserva() && estadoDespues == 'cancelado')
              || (ordenAntes.estado == 'entrega_parcial' && estadoDespues == 'entregado'))
        && igualCantidad(antes.reservado - nuevo.reservado, saldoLote(ordenAntes, codigo))
        && nuevo.reservado > -0.000001;
    }

    // Ajuste aprobado: la distribución de la orden cambia (antes de cualquier entrega) y el inventario
    // de este lote se mueve exactamente la diferencia, sin superar lo cosechado si aumenta
    function ajusteValido(codigo, antes, nuevo) {
      let id = nuevo.ultimaOrden;
      let oa = get(rutaOrden(id)).data;
      let od = getAfter(rutaOrden(id)).data;
      let cantAntes = oa.procedencias.get(codigo, {'cantidad': 0}).cantidad;
      let cantDespues = od.procedencias.get(codigo, {'cantidad': 0}).cantidad;
      let lote = get(rutaLote(codigo)).data;
      return oa.estado in estadosConReserva()
        && od.estado == oa.estado
        && oa.cantidadEntregada == 0
        && od.unidad == nuevo.unidad
        && od.granjaId == nuevo.granjaId
        && !igualCantidad(cantAntes, cantDespues)
        && igualCantidad(nuevo.reservado - antes.reservado, cantDespues - cantAntes)
        && (!(codigo in od.procedencias)
            || (od.procedencias[codigo].estanque == lote.estanque && od.procedencias[codigo].unidad == nuevo.unidad))
        && nuevo.reservado > -0.000001
        && (cantDespues < cantAntes || nuevo.reservado + nuevo.entregado <= cosechado(lote, nuevo.unidad) + 0.000001);
    }

    // Entrega confirmada por el repartidor asignado: lo entregado de este lote pasa de reservado a
    // entregado, en la misma operación en que la orden registra la entrega
    function entregaValida(codigo, antes, nuevo) {
      let id = nuevo.ultimaOrden;
      let oa = get(rutaOrden(id)).data;
      let od = getAfter(rutaOrden(id)).data;
      let d = od.entregadoPorLote[codigo] - oa.get('entregadoPorLote', {}).get(codigo, 0);
      return od.repartidorUid == request.auth.uid
        && oa.estado == 'en_ruta'
        && od.estado in ['entregado', 'entrega_parcial']
        && d > 0
        && igualCantidad(nuevo.entregado - antes.entregado, d)
        && igualCantidad(antes.reservado - nuevo.reservado, d)
        && nuevo.reservado > -0.000001;
    }

    // movidoEn es la hora del servidor de esta operación: así la orden comprueba que se movió aquí.
    // Cada movimiento declara su tipo; sin tipo (versión anterior de la app) se trata como reserva.
    // Todo movimiento exige que su orden cambie en esta misma operación de una forma que solo permite
    // la regla de ordenes (quien gestiona pedidos reserva, libera o ajusta; el repartidor asignado
    // entrega), así que el permiso queda validado allí sin repetirlo aquí.
    function inventarioCreacionValido(codigo) {
      let nuevo = request.resource.data;
      let tipo = nuevo.get('tipoMovimiento', 'reserva');
      return nuevo.keys().hasOnly(['codigoLote', 'granjaId', 'unidad', 'reservado', 'entregado', 'ultimaOrden', 'movidoEn', 'tipoMovimiento'])
        && nuevo.codigoLote == codigo
        && nuevo.movidoEn == request.time
        && nuevo.unidad in ['peces', 'kg']
        && nuevo.entregado == 0
        && nuevo.granjaId == get(rutaLote(codigo)).data.get('granjaId', 'cultivos-lore')
        && isSignedIn()
        && ((tipo == 'reserva' && reservaValida(codigo, 0, nuevo))
            || (tipo == 'ajuste' && ajusteValido(codigo, {'reservado': 0, 'entregado': 0}, nuevo)));
    }

    // Quien gestiona pedidos reserva, libera o ajusta; el repartidor asignado solo registra entregas.
    // La unidad nunca cambia.
    function inventarioActualizacionValida(codigo) {
      let antes = resource.data;
      let nuevo = request.resource.data;
      let tipo = nuevo.get('tipoMovimiento', '');
      let cambios = nuevo.diff(antes).affectedKeys();
      return nuevo.movidoEn == request.time
        && ((tipo == 'entrega'
              && cambios.hasOnly(['reservado', 'entregado', 'ultimaOrden', 'movidoEn', 'tipoMovimiento'])
              && entregaValida(codigo, antes, nuevo))
            || (tipo != 'entrega'
              && cambios.hasOnly(['reservado', 'ultimaOrden', 'movidoEn', 'tipoMovimiento'])
              && isSignedIn()
              && ((tipo == 'reserva' && reservaValida(codigo, antes.reservado, nuevo))
                  || (tipo == 'liberacion' && liberacionValida(codigo, antes, nuevo))
                  || (tipo == 'ajuste' && ajusteValido(codigo, antes, nuevo))
                  // Sin tipo (versión anterior de la app): reserva o liberación, como en la fase 2
                  || (tipo == '' && (reservaValida(codigo, antes.reservado, nuevo) || liberacionValida(codigo, antes, nuevo))))));
    }

    match /inventarioLotes/{codigo} {
      // get sobre un inventario que aún no existe: lo hace la transacción antes de la primera reserva
      allow get: if puedeGestionarPedidos() && (resource == null || granjaPermitida(resource.data.granjaId));
      allow list: if puedeGestionarPedidos() && granjaPermitida(resource.data.granjaId);
      allow create: if inventarioCreacionValido(codigo);
      allow update: if inventarioActualizacionValida(codigo);
      allow delete: if false;
    }

    match /clientes/{clienteId} {
      allow get: if puedeGestionarPedidos() && (resource == null || granjaPermitida(resource.data.granjaId));
      allow list: if puedeGestionarPedidos() && granjaPermitida(resource.data.granjaId);

      allow create: if request.resource.data.keys().hasOnly(['granjaId', 'nombre', 'contacto', 'direccion', 'creadoPor', 'creadoPorUid', 'creadoEn', 'actualizadoEn'])
        && gestionaPedidosEn(request.resource.data.granjaId)
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.contacto is string
        && request.resource.data.contacto.size() <= 200
        && request.resource.data.get('direccion', '') is string
        && request.resource.data.get('direccion', '').size() <= 300
        && request.resource.data.creadoPorUid == request.auth.uid
        && request.resource.data.creadoPor.lower() == correoSesion();

      allow update: if soloCambia(['nombre', 'contacto', 'direccion', 'actualizadoEn'])
        && gestionaPedidosEn(resource.data.granjaId)
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.get('direccion', '').size() <= 300;

      allow delete: if false;
    }

    // ===== ordenes =====
    // Campos permitidos; los de la lista requerida existen en todas las órdenes (las anteriores a la
    // fase 3 no tienen los de entrega y seguimiento)
    function camposOrden() {
      return ['id', 'granjaId', 'clienteId', 'clienteNombre', 'creadoPor', 'creadoPorUid', 'repartidorUid',
              'repartidorNombre', 'creadoEn', 'actualizadoEn', 'fechaProgramada', 'unidad', 'cantidadSolicitada',
              'procedencias', 'cantidadAutorizada', 'cantidadEntregada', 'estado', 'observaciones', 'historial',
              'clienteDireccion', 'clienteContacto', 'entregadoPorLote', 'cantidadLiberada', 'rutaIniciadaEn',
              'llegadaEn', 'ajustes', 'atencionNovedades'];
    }

    function camposOrdenRequeridos() {
      return ['id', 'granjaId', 'clienteId', 'clienteNombre', 'creadoPor', 'creadoPorUid', 'repartidorUid',
              'repartidorNombre', 'creadoEn', 'actualizadoEn', 'fechaProgramada', 'unidad', 'cantidadSolicitada',
              'procedencias', 'cantidadAutorizada', 'cantidadEntregada', 'estado', 'observaciones', 'historial'];
    }

    // Repartidor asignable: cuenta activa de la misma granja con el rol de repartidor
    function repartidorValido(uid, granja) {
      let p = get(/databases/$(database)/documents/usuarios/$(uid)).data;
      return p.get('estado', '') == 'activo'
        && rolesDe(p).hasAny(['courier'])
        && p.get('granjaId', 'cultivos-lore') == granja;
    }

    function clienteValido(orden) {
      return getAfter(/databases/$(database)/documents/clientes/$(orden.clienteId)).data.granjaId == orden.granjaId;
    }

    // Cantidad de la procedencia i (0 si no existe); las claves son códigos de lote
    function cantidadProcedencia(p, claves, i) {
      return claves.size() <= i ? 0 : p[claves[i]].cantidad;
    }

    function procedenciaValida(p, claves, i, unidad) {
      return claves.size() <= i
        || (p[claves[i]].cantidad > 0 && p[claves[i]].unidad == unidad && p[claves[i]].estanque is string);
    }

    function totalDistribucion(p) {
      let claves = p.keys();
      return cantidadProcedencia(p, claves, 0) + cantidadProcedencia(p, claves, 1) + cantidadProcedencia(p, claves, 2);
    }

    // Distribución: hasta 3 lotes, cantidades positivas en la unidad de la orden, sin superar lo solicitado
    function distribucionValida(orden) {
      let p = orden.procedencias;
      let claves = p.keys();
      return claves.size() <= 3
        && procedenciaValida(p, claves, 0, orden.unidad)
        && procedenciaValida(p, claves, 1, orden.unidad)
        && procedenciaValida(p, claves, 2, orden.unidad)
        && totalDistribucion(p) <= orden.cantidadSolicitada + 0.000001;
    }

    // El inventario del lote se movió en esta misma operación a nombre de esta orden: queda con la
    // hora de esta operación y antes tenía otra (o no existía). La cantidad del movimiento la valida
    // la regla de inventarioLotes.
    function movidoAqui(id, codigo) {
      let despues = getAfter(rutaInventario(codigo)).data;
      return despues.movidoEn == request.time
        && despues.ultimaOrden == id
        && (!exists(rutaInventario(codigo)) || get(rutaInventario(codigo)).data.movidoEn != request.time);
    }

    function loteMovido(id, claves, i) {
      return claves.size() <= i || movidoAqui(id, claves[i]);
    }

    function lotesMovidos(id, procedencias) {
      let claves = procedencias.keys();
      return loteMovido(id, claves, 0) && loteMovido(id, claves, 1) && loteMovido(id, claves, 2);
    }

    // Lotes de la orden con saldo por entregar: todos deben liberarse en esta operación
    function saldoMovido(id, orden, claves, i) {
      return claves.size() <= i
        || saldoLote(orden, claves[i]) <= 0.000001
        || movidoAqui(id, claves[i]);
    }

    function saldosLiberados(id, orden) {
      let claves = orden.procedencias.keys();
      return saldoMovido(id, orden, claves, 0) && saldoMovido(id, orden, claves, 1) && saldoMovido(id, orden, claves, 2);
    }

    // Orden asignada: repartidor válido, al menos un lote, todos sus lotes reservados en esta
    // operación y lo autorizado igual a lo distribuido
    function asignacionValida(id, orden) {
      let p = orden.procedencias;
      return p.keys().size() > 0
        && repartidorValido(orden.repartidorUid, orden.granjaId)
        && igualCantidad(orden.cantidadAutorizada, totalDistribucion(p))
        && lotesMovidos(id, p);
    }

    // Datos editables de una orden sin reservas (nueva o borrador)
    function datosOrdenValidos(orden) {
      return orden.keys().hasOnly(camposOrden())
        && orden.keys().hasAll(camposOrdenRequeridos())
        && orden.unidad in ['peces', 'kg']
        && orden.cantidadSolicitada > 0
        && orden.observaciones is string
        && orden.observaciones.size() <= 1000
        && orden.get('clienteDireccion', '').size() <= 300
        && orden.get('clienteContacto', '').size() <= 200
        && distribucionValida(orden)
        && clienteValido(orden);
    }

    // El evento nuevo va al final, con el índice siguiente y firmado por quien tiene la sesión
    function eventoOrdenValido(evento, indice) {
      return evento.indice == indice
        && evento.registradoPor.lower() == correoSesion()
        && evento.registradoPorUid == request.auth.uid;
    }

    // Cambios de estado manuales del operador. Iniciar la ruta, llegar y entregar son acciones del
    // repartidor; la entrega parcial se resuelve reprogramando el saldo o liberándolo.
    function transicionPermitida(de, a) {
      return (de == 'asignado' && a in ['asignado', 'en_preparacion', 'requiere_revision'])
        || (de == 'en_preparacion' && a in ['en_preparacion', 'requiere_revision'])
        || (de == 'en_ruta' && a in ['en_ruta', 'requiere_revision'])
        || (de == 'requiere_revision' && a in ['requiere_revision', 'asignado', 'en_preparacion']);
    }

    function puedeVerOrden(orden) {
      return (puedeGestionarPedidos() && granjaPermitida(orden.granjaId))
        || (orden.repartidorUid == request.auth.uid && tieneRol('courier'));
    }

    // Crear: como borrador (sin reservas) o directamente asignada con sus reservas aplicadas
    function creacionOrdenValida(id) {
      let o = request.resource.data;
      return o.id == id
        && o.creadoPorUid == request.auth.uid
        && o.creadoPor.lower() == correoSesion()
        && o.cantidadEntregada == 0
        && o.historial.size() == 1
        && !('entregadoPorLote' in o)
        && !('ajustes' in o)
        && !('atencionNovedades' in o)
        && gestionaPedidosEn(o.granjaId)
        && o.historial[0].tipo == 'Creación'
        && eventoOrdenValido(o.historial[0], 0)
        && datosOrdenValidos(o)
        && ((o.estado == 'borrador'
              && o.cantidadAutorizada == 0
              && (o.repartidorUid == null || repartidorValido(o.repartidorUid, o.granjaId)))
            || (o.estado == 'asignado' && asignacionValida(id, o)));
    }

    // ----- caminos del operador -----
    // Editar un borrador, o confirmarlo (reserva y asignación)
    function borradorValido(id, antes, despues, cambios) {
      return cambios.hasOnly(['clienteId', 'clienteNombre', 'clienteDireccion', 'clienteContacto', 'repartidorUid',
                              'repartidorNombre', 'actualizadoEn', 'fechaProgramada', 'unidad', 'cantidadSolicitada',
                              'procedencias', 'cantidadAutorizada', 'estado', 'observaciones', 'historial'])
        && datosOrdenValidos(despues)
        && ((despues.estado == 'borrador'
              && despues.cantidadAutorizada == 0
              && (despues.repartidorUid == null || repartidorValido(despues.repartidorUid, antes.granjaId)))
            || (despues.estado == 'asignado' && asignacionValida(id, despues)));
    }

    // Cambio de estado o de repartidor sin tocar lo reservado (en ruta no se cambia el repartidor)
    function transicionValida(antes, despues, cambios) {
      return transicionPermitida(antes.estado, despues.estado)
        && cambios.hasOnly(['estado', 'repartidorUid', 'repartidorNombre', 'fechaProgramada', 'observaciones', 'actualizadoEn', 'historial'])
        && (despues.repartidorUid == antes.repartidorUid
            || (antes.estado != 'en_ruta' && repartidorValido(despues.repartidorUid, antes.granjaId)));
    }

    // Cancelar: un borrador, o una orden con reservas liberando el saldo en la misma operación
    function cancelacionValida(id, antes, despues, cambios) {
      return despues.estado == 'cancelado'
        && cambios.hasOnly(['estado', 'actualizadoEn', 'historial'])
        && (antes.estado == 'borrador' || (antes.estado in estadosConReserva() && saldosLiberados(id, antes)));
    }

    // Entrega parcial: reprogramar el saldo (vuelve a asignado para una nueva ruta)
    function reprogramacionValida(antes, despues, cambios) {
      return antes.estado == 'entrega_parcial'
        && despues.estado == 'asignado'
        && cambios.hasOnly(['estado', 'rutaIniciadaEn', 'llegadaEn', 'repartidorUid', 'repartidorNombre', 'fechaProgramada',
                            'observaciones', 'actualizadoEn', 'historial'])
        && despues.get('rutaIniciadaEn', null) == null
        && despues.get('llegadaEn', null) == null
        && (despues.repartidorUid == antes.repartidorUid || repartidorValido(despues.repartidorUid, antes.granjaId));
    }

    // Entrega parcial: liberar el saldo y cerrar (sin pendientes)
    function cierreSaldoValido(id, antes, despues, cambios) {
      return antes.estado == 'entrega_parcial'
        && despues.estado == 'entregado'
        && cambios.hasOnly(['estado', 'cantidadLiberada', 'actualizadoEn', 'historial'])
        && igualCantidad(despues.cantidadLiberada, antes.cantidadAutorizada - antes.cantidadEntregada)
        && saldosLiberados(id, antes);
    }

    // Solo cambia la solicitud indicada en el evento (no se pueden tocar las demás)
    function soloCambiaAjuste(antes, despues, id) {
      let d = despues.ajustes.diff(antes.get('ajustes', {}));
      return d.addedKeys().size() == 0 && d.removedKeys().size() == 0 && d.changedKeys().hasOnly([id]);
    }

    // El operador resuelve una solicitud pendiente que no hizo él mismo; la solicitud original queda intacta
    function resolucionValida(antes, despues, id, estadoFinal) {
      let a = antes.ajustes[id];
      let b = despues.ajustes[id];
      return a.estado == 'pendiente_aprobacion'
        && b.estado == estadoFinal
        && a.solicitadoPorUid != request.auth.uid
        && b.resueltoPorUid == request.auth.uid
        && b.resueltoPor.lower() == correoSesion()
        && b.propuesta == a.propuesta
        && b.original == a.original
        && b.motivo == a.motivo
        && b.solicitadoPorUid == a.solicitadoPorUid
        && b.solicitadoEn == a.solicitadoEn
        && soloCambiaAjuste(antes, despues, id);
    }

    // La nueva distribución es exactamente la propuesta (mismos lotes y cantidades)
    function cantidadPropuesta(p, propuesta, claves, i) {
      return claves.size() <= i || igualCantidad(p[claves[i]].cantidad, propuesta[claves[i]]);
    }

    function distribucionEsPropuesta(p, propuesta) {
      let claves = propuesta.keys();
      return p.keys().hasOnly(claves) && p.keys().hasAll(claves)
        && cantidadPropuesta(p, propuesta, claves, 0)
        && cantidadPropuesta(p, propuesta, claves, 1)
        && cantidadPropuesta(p, propuesta, claves, 2);
    }

    // Cada lote de la distribución anterior o de la nueva: queda igual, o su inventario se movió en
    // esta operación (y la regla del inventario valida la diferencia, la piscina y la unidad)
    function loteAjustado(id, pa, pd, claves, i) {
      return claves.size() <= i
        || pa.get(claves[i], null) == pd.get(claves[i], null)
        || movidoAqui(id, claves[i]);
    }

    function lotesAjustados(id, pa, pd) {
      let ka = pa.keys();
      let kd = pd.keys();
      return loteAjustado(id, pa, pd, ka, 0) && loteAjustado(id, pa, pd, ka, 1) && loteAjustado(id, pa, pd, ka, 2)
        && loteNuevoMovido(id, pa, kd, 0) && loteNuevoMovido(id, pa, kd, 1) && loteNuevoMovido(id, pa, kd, 2);
    }

    // Lote que entra en la distribución nueva: su inventario se movió en esta operación
    function loteNuevoMovido(id, pa, claves, i) {
      return claves.size() <= i || claves[i] in pa || movidoAqui(id, claves[i]);
    }

    // Aprobar y aplicar una solicitud antes de cualquier entrega: la distribución pasa a ser la
    // propuesta (validada al crear la solicitud: hasta 3 lotes y sin superar lo solicitado) y el
    // inventario de cada lote afectado se mueve en esta misma operación
    function ajusteAplicadoValido(id, antes, despues, cambios, aid) {
      return antes.estado in estadosConReserva()
        && antes.cantidadEntregada == 0
        && cambios.hasOnly(['ajustes', 'procedencias', 'cantidadAutorizada', 'actualizadoEn', 'historial'])
        && resolucionValida(antes, despues, aid, 'aplicada')
        && distribucionEsPropuesta(despues.procedencias, despues.ajustes[aid].propuesta)
        && igualCantidad(despues.cantidadAutorizada, totalDistribucion(despues.procedencias))
        && lotesAjustados(id, antes.procedencias, despues.procedencias);
    }

    // Operador: cada actualización agrega exactamente un evento al historial; el tipo del evento
    // decide qué cambios se validan. El creador, la granja y lo entregado no cambian.
    function actualizacionOperadorValida(id) {
      let antes = resource.data;
      let despues = request.resource.data;
      let n = antes.historial.size();
      let evento = despues.historial[n];
      let tipo = evento.tipo;
      let cambios = despues.diff(antes).affectedKeys();
      return tipo in ['Modificación', 'Cambio de repartidor', 'Asignación y reserva', 'Cambio de estado', 'Cancelación',
                      'Reprogramación de saldo', 'Cierre con saldo liberado', 'Ajuste rechazado', 'Ajuste aplicado',
                      'Atención de novedad']
        && despues.historial.size() == n + 1
        && eventoOrdenValido(evento, n)
        && despues.historial[0:n] == antes.historial
        && gestionaPedidosEn(antes.granjaId)
        && ((tipo in ['Modificación', 'Cambio de repartidor', 'Asignación y reserva'] && antes.estado == 'borrador'
              && borradorValido(id, antes, despues, cambios))
            || (tipo in ['Cambio de estado', 'Cambio de repartidor'] && antes.estado != 'borrador'
              && transicionValida(antes, despues, cambios))
            || (tipo == 'Cancelación' && cancelacionValida(id, antes, despues, cambios))
            || (tipo == 'Reprogramación de saldo' && reprogramacionValida(antes, despues, cambios))
            || (tipo == 'Cierre con saldo liberado' && cierreSaldoValido(id, antes, despues, cambios))
            || (tipo == 'Ajuste rechazado'
              && cambios.hasOnly(['ajustes', 'actualizadoEn', 'historial'])
              && resolucionValida(antes, despues, evento.datos.ajusteId, 'rechazada'))
            || (tipo == 'Ajuste aplicado'
              && ajusteAplicadoValido(id, antes, despues, cambios, evento.datos.ajusteId))
            || (tipo == 'Atención de novedad' && atencionNovedadValida(antes, despues, cambios, evento)));
    }

    // Atención de una novedad del repartidor (estado interno, distinto del estado de la orden): solo
    // cambia la entrada de esa novedad en atencionNovedades, que apunta a un evento "Novedad" real del
    // historial. La novedad original no se toca; las observaciones quedan en el evento de atención.
    function atencionNovedadValida(antes, despues, cambios, evento) {
      let nid = evento.datos.novedadId;
      let original = antes.historial[evento.datos.novedadIndice];
      let d = despues.atencionNovedades.diff(antes.get('atencionNovedades', {}));
      let a = despues.atencionNovedades[nid];
      return cambios.hasOnly(['atencionNovedades', 'actualizadoEn', 'historial'])
        && original.tipo == 'Novedad'
        && original.eventoId == nid
        && d.removedKeys().size() == 0
        && d.affectedKeys().hasOnly([nid])
        && d.affectedKeys().size() == 1
        && a.estado in ['pendiente', 'en_revision', 'atendida', 'cerrada']
        && a.actualizadoPorUid == request.auth.uid
        && a.actualizadoPor.lower() == correoSesion()
        && evento.descripcion.size() <= 1000;
    }

    // ----- acciones del repartidor -----
    // Entrega por lote: no baja lo ya entregado, no supera lo autorizado del lote, y si cambia, el
    // inventario del lote se movió en esta operación
    function entregaLote(id, antes, e0, e1, claves, i) {
      return claves.size() <= i
        || (e1.get(claves[i], 0) >= e0.get(claves[i], 0)
            && e1.get(claves[i], 0) <= antes.procedencias[claves[i]].cantidad + 0.000001
            && (e1.get(claves[i], 0) == e0.get(claves[i], 0) || movidoAqui(id, claves[i])));
    }

    function entregadoLote(e1, claves, i) {
      return claves.size() <= i ? 0 : e1.get(claves[i], 0);
    }

    // Entrega total o parcial: lo entregado suma lo de cada lote, no supera lo autorizado, y la orden
    // queda entregada solo si no queda saldo
    function entregaOrdenValida(id, antes, despues) {
      let claves = antes.procedencias.keys();
      let e0 = antes.get('entregadoPorLote', {});
      let e1 = despues.entregadoPorLote;
      return e1.keys().hasOnly(claves)
        && despues.cantidadEntregada > antes.cantidadEntregada
        && despues.cantidadEntregada <= antes.cantidadAutorizada + 0.000001
        && igualCantidad(despues.cantidadEntregada,
             entregadoLote(e1, claves, 0) + entregadoLote(e1, claves, 1) + entregadoLote(e1, claves, 2))
        && despues.estado == (igualCantidad(despues.cantidadEntregada, antes.cantidadAutorizada) ? 'entregado' : 'entrega_parcial')
        && entregaLote(id, antes, e0, e1, claves, 0)
        && entregaLote(id, antes, e0, e1, claves, 1)
        && entregaLote(id, antes, e0, e1, claves, 2);
    }

    // Solicitud nueva del repartidor: agrega solo esa solicitud, pendiente, a su nombre, con la
    // distribución vigente como original y una propuesta de hasta 3 lotes que no supere lo solicitado
    function solicitudNueva(antes, despues, id) {
      let d = despues.ajustes.diff(antes.get('ajustes', {}));
      let a = despues.ajustes[id];
      let claves = a.propuesta.keys();
      return d.addedKeys().hasOnly([id]) && d.addedKeys().size() == 1
        && d.changedKeys().size() == 0 && d.removedKeys().size() == 0
        && a.id == id
        && a.estado == 'pendiente_aprobacion'
        && a.solicitadoPorUid == request.auth.uid
        && a.solicitadoPor.lower() == correoSesion()
        && a.original == antes.procedencias
        && a.motivo is string && a.motivo.size() > 0 && a.motivo.size() <= 1000
        && claves.size() > 0 && claves.size() <= 3
        && (claves.size() <= 0 || a.propuesta[claves[0]] > 0)
        && (claves.size() <= 1 || a.propuesta[claves[1]] > 0)
        && (claves.size() <= 2 || a.propuesta[claves[2]] > 0)
        && (claves.size() > 0 ? a.propuesta[claves[0]] : 0)
             + (claves.size() > 1 ? a.propuesta[claves[1]] : 0)
             + (claves.size() > 2 ? a.propuesta[claves[2]] : 0) <= antes.cantidadSolicitada + 0.000001;
    }

    function cancelacionSolicitudValida(antes, despues, id) {
      let a = antes.ajustes[id];
      let b = despues.ajustes[id];
      return a.estado == 'pendiente_aprobacion'
        && b.estado == 'cancelada'
        && a.solicitadoPorUid == request.auth.uid
        && b.solicitadoPorUid == a.solicitadoPorUid
        && b.propuesta == a.propuesta
        && b.original == a.original
        && b.motivo == a.motivo
        && b.solicitadoEn == a.solicitadoEn
        && soloCambiaAjuste(antes, despues, id);
    }

    // Repartidor asignado: solo sus acciones sobre la entrega, cada una con un evento propio (con
    // identificador único y la función de repartidor). No cambia cantidades autorizadas,
    // distribución, repartidor ni datos del cliente.
    function actualizacionRepartidorValida(id) {
      let antes = resource.data;
      let despues = request.resource.data;
      let n = antes.historial.size();
      let evento = despues.historial[n];
      let tipo = evento.tipo;
      let cambios = despues.diff(antes).affectedKeys();
      return antes.repartidorUid == request.auth.uid
        && despues.historial.size() == n + 1
        && tipo in ['Inicio de ruta', 'Llegada', 'Novedad', 'Entrega', 'Solicitud de ajuste', 'Cancelación de solicitud']
        && evento.funcion == 'courier'
        && evento.eventoId is string
        && eventoOrdenValido(evento, n)
        && despues.historial[0:n] == antes.historial
        && tieneRol('courier')
        && (
          // Iniciar ruta: desde asignado o en preparación
          (tipo == 'Inicio de ruta'
            && antes.estado in ['asignado', 'en_preparacion']
            && despues.estado == 'en_ruta'
            && cambios.hasOnly(['estado', 'rutaIniciadaEn', 'llegadaEn', 'actualizadoEn', 'historial'])
            && despues.rutaIniciadaEn is string
            && despues.get('llegadaEn', null) == null)
          // Registrar llegada: solo con la ruta iniciada y una sola vez
          || (tipo == 'Llegada'
            && antes.estado == 'en_ruta'
            && antes.get('rutaIniciadaEn', null) != null
            && antes.get('llegadaEn', null) == null
            && cambios.hasOnly(['llegadaEn', 'actualizadoEn', 'historial'])
            && despues.llegadaEn is string)
          // Novedad: en cualquier estado activo; solo agrega el evento
          || (tipo == 'Novedad'
            && antes.estado in ['asignado', 'en_preparacion', 'en_ruta', 'entrega_parcial', 'requiere_revision']
            && cambios.hasOnly(['actualizadoEn', 'historial'])
            && evento.descripcion.size() > 0
            && evento.descripcion.size() <= 1000)
          // Confirmar entrega (total o parcial): después de registrar la llegada
          || (tipo == 'Entrega'
            && antes.estado == 'en_ruta'
            && antes.get('llegadaEn', null) != null
            && cambios.hasOnly(['estado', 'entregadoPorLote', 'cantidadEntregada', 'actualizadoEn', 'historial'])
            && entregaOrdenValida(id, antes, despues))
          // Solicitar ajuste: queda pendiente de aprobación; la distribución vigente no cambia
          || (tipo == 'Solicitud de ajuste'
            && antes.estado in estadosConReserva()
            && antes.cantidadEntregada == 0
            && cambios.hasOnly(['ajustes', 'actualizadoEn', 'historial'])
            && solicitudNueva(antes, despues, evento.datos.ajusteId))
          // Cancelar una solicitud propia que sigue pendiente
          || (tipo == 'Cancelación de solicitud'
            && cambios.hasOnly(['ajustes', 'actualizadoEn', 'historial'])
            && cancelacionSolicitudValida(antes, despues, evento.datos.ajusteId))
        );
    }

    match /ordenes/{ordenId} {
      allow get: if (resource == null && puedeGestionarPedidos()) || (resource != null && puedeVerOrden(resource.data));
      allow list: if puedeVerOrden(resource.data);
      allow create: if creacionOrdenValida(ordenId);
      allow update: if actualizacionOperadorValida(ordenId) || actualizacionRepartidorValida(ordenId);
      allow delete: if false;
    }


    // ---------- Contadores ----------
    // Solo quien puede crear lotes usa los contadores, y solo pueden avanzar de uno en uno
    match /contadores/{contadorId} {
      allow read: if isValidId(contadorId) && tienePermiso('crearLotes');
      allow create: if isValidId(contadorId)
        && tienePermiso('crearLotes')
        && request.resource.data.keys().hasOnly(['valor', 'actualizadoEn'])
        && request.resource.data.valor == 1;
      allow update: if isValidId(contadorId)
        && tienePermiso('crearLotes')
        && request.resource.data.keys().hasOnly(['valor', 'actualizadoEn'])
        && request.resource.data.valor == resource.data.valor + 1;
      allow delete: if false;
    }

    // ---------- Configuración General ----------
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if isMasterAdmin() || esAdminGranja() || tienePermiso('gestionarConfiguracion') || tienePermiso('gestionarEstanques');
    }

    // ---------- Perfiles de Usuario ----------
    function granjaUsuario() {
      return perfil().get('granjaId', 'cultivos-lore');
    }

    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function esPerfilMaestro(datos) {
      return datos.get('email', '').lower() == 'carlosbs1579@gmail.com';
    }

    function esPerfilAdmin(datos) {
      return datos.get('rol', '') == 'admin';
    }

    function cargoValido(cargos, rol) {
      return !(rol in cargos) || (cargos[rol] is string && cargos[rol].size() <= 80);
    }

    // Lista de roles válida y coherente con el campo rol (admin en la lista si y solo si rol es admin)
    function rolesAsignablesValidos(datos) {
      return !('roles' in datos)
        || (datos.roles is list
            && datos.roles.size() <= 3
            && datos.roles.hasOnly(['admin', 'operator', 'courier'])
            && datos.roles.hasAny(['admin']) == esPerfilAdmin(datos));
    }

    // Nombres visibles por función: solo texto, y solo para funciones existentes
    function cargosValidos(datos) {
      return !('cargos' in datos)
        || (datos.cargos is map
            && datos.cargos.keys().hasOnly(['admin', 'operator', 'courier'])
            && cargoValido(datos.cargos, 'admin')
            && cargoValido(datos.cargos, 'operator')
            && cargoValido(datos.cargos, 'courier'));
    }

    // Valores válidos que un administrador puede asignar a un perfil
    function perfilAsignableValido() {
      return request.resource.data.get('rol', 'operario') in ['admin', 'operario', 'consulta']
        && request.resource.data.get('estado', 'pendiente') in ['activo', 'pendiente', 'inactivo']
        && rolesAsignablesValidos(request.resource.data)
        && cargosValidos(request.resource.data)
        && (isMasterAdmin() || request.resource.data.get('granjaId', 'cultivos-lore') == granjaUsuario());
    }

    match /usuarios/{userId} {
      // Cada usuario lee su propio perfil; los administradores leen todos (pestaña Usuarios)
      allow read: if (isSignedIn() && request.auth.uid == userId) || esAdminGranja();

      // Quien gestiona pedidos consulta los repartidores activos de su granja para asignarlos
      allow list: if puedeGestionarPedidos()
        && resource.data.get('roles', []).hasAny(['courier'])
        && resource.data.get('estado', '') == 'activo'
        && granjaPermitida(resource.data.get('granjaId', 'cultivos-lore'));

      // Alta propia al primer ingreso: siempre operario pendiente, sin permisos ni funciones, en la
      // granja predeterminada
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == correoSesion()
        && request.resource.data.rol == 'operario'
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.granjaId == 'cultivos-lore'
        && !request.resource.data.permisos.values().hasAny([true])
        && request.resource.data.get('roles', []).size() == 0
        && request.resource.data.get('cargos', {}).size() == 0;

      // El Administrador Maestro crea o actualiza su propio perfil con todos los permisos
      allow create, update: if isMasterAdmin() && request.auth.uid == userId;

      // Cambio propio permitido a cualquier usuario: solo el nombre visible
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && soloCambia(['displayName', 'actualizadoEn']);

      // Un administrador crea perfiles de otros usuarios (si aún no existían)...
      // Solo el Administrador Maestro otorga el rol de administrador.
      allow create: if esAdminGranja()
        && request.auth.uid != userId
        && !esPerfilMaestro(request.resource.data)
        && (isMasterAdmin() || !esPerfilAdmin(request.resource.data))
        && perfilAsignableValido();

      // ...y gestiona sus roles, nombres de función, estado y permisos, sin cambiarles el correo.
      // El perfil del Administrador Maestro solo lo modifica él mismo, y los perfiles de los demás
      // administradores (o convertir a alguien en administrador) solo el Administrador Maestro.
      // Nadie modifica sus propios roles por esta vía.
      allow update: if esAdminGranja()
        && request.auth.uid != userId
        && !esPerfilMaestro(resource.data)
        && (isMasterAdmin() || resource.data.get('granjaId', 'cultivos-lore') == granjaUsuario())
        && (isMasterAdmin() || (!esPerfilAdmin(resource.data) && !esPerfilAdmin(request.resource.data)))
        && soloCambia(['rol', 'roles', 'cargos', 'granjaId', 'cargo', 'estado', 'permisos', 'autorizadoPor', 'actualizadoEn', 'email', 'displayName'])
        && request.resource.data.get('email', '').lower() == resource.data.get('email', '').lower()
        && perfilAsignableValido();

      // Borrar perfiles: administradores de la misma granja; nunca el del Administrador Maestro, y
      // los de otros administradores solo el Administrador Maestro
      allow delete: if esAdminGranja()
        && !esPerfilMaestro(resource.data)
        && (isMasterAdmin() || !esPerfilAdmin(resource.data))
        && (isMasterAdmin() || resource.data.get('granjaId', 'cultivos-lore') == granjaUsuario());
    }
  }
}
